{
  "hosting": {
    "public": "fe/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
  {
    "source": "/api/**",
    "destination": "https://fitora-2jck.onrender.com/api/**"
  },
  {
    "source": "**",
    "destination": "/index.html"
  }
]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "hosting": {
      "port": 5000
    },
    "singleProjectMode": true
  }
}
